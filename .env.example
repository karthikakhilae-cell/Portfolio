# Groq API key — get yours free at https://console.groq.com
GQ_API_KEY="your_groq_api_key_here"

# Google Apps Script URL for contact form
GOOGLE_APPS_SCRIPT_URL="your_apps_script_url_here"

# App URL (used in production)
APP_URL="https://yourportfolio.com"

# Optional: GitHub personal access token (raises the GitHub API rate limit
# from 60 to 5000 requests/hour for auto-fetching projects and READMEs)
GITHUB_TOKEN=""
